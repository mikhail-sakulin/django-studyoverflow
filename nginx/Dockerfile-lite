FROM nginx:latest

# Создается папка для хранения исходных конфигов
RUN mkdir -p /etc/nginx/source_configs

# Копирование Nginx конфигураций для http и https
COPY http-lite.conf /etc/nginx/source_configs/http-lite.conf
COPY https-lite.conf /etc/nginx/source_configs/https-lite.conf
# Копирование скрипта инициализации контейнера
COPY entrypoint-lite.sh /entrypoint-lite.sh

# Удаление символов возврата каретки (\r) из скрипта - перевод окончаний строк из Windows (CRLF - \r\n) в Linux (LF - \n).
# Первая строка скрипта "#!/bin/sh" указывает, какой программой его запускать. Без удаления \r ядро Linux
# прочитает строку как "/bin/sh\r", не найдет такой интерпретатор и выведет "no such file or directory".
# sed - потоковый редактор текста, построчно применяет к файлу заданное правило;
# -i - изменять файл на месте, а не выводить результат в консоль;
# 's/\r$//' - правило замены в формате s/что_заменить/на_что_заменить/:
#   \r - символ возврата каретки;
#   $ - конец строки;
#   // - пустая строка вместо найденного \r;
RUN sed -i 's/\r$//' /entrypoint-lite.sh

# Команда делает скрипт исполняемым,
# chmod - изменяет права доступа,
# +x - задает право на запуск файла как программы.
RUN chmod +x /entrypoint-lite.sh

# Очистка рабочей директории конфигов,
# -r - рекурсивно удаляет подпапки и их содержимое.
RUN rm -rf /etc/nginx/conf.d/*

ENTRYPOINT ["/entrypoint-lite.sh"]