DJANGO_SECRET_KEY=test-key-not-secret-test-key-not-secret

DEBUG=False

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Настройки тестовой БД
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db
# При тестировании через docker-compose.test.yml (например в CI/CD) переопределяются
# переменные POSTGRES_HOST и POSTGRES_PORT, используя docker контейнер с postgresql:
#     environment:
#       POSTGRES_HOST: "postgres"
#       POSTGRES_PORT: "5432"
#
# Имя сервиса PostgreSQL в сети Docker Compose, куда нужно обращаться Django приложени
POSTGRES_HOST=localhost
# Порт PostgreSQL, куда нужно обращаться Django приложению
POSTGRES_PORT=5432

# Указанные ниже сервисы для тестов не нужны, параметры задаются для корректного запуска приложения
# для тестирования.
AWS_ACCESS_KEY_ID=test-access-key-here
AWS_SECRET_ACCESS_KEY=test-secret-key-here
AWS_STORAGE_BUCKET_NAME=test-example-bucket

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=test_email@example.ru
EMAIL_HOST_PASSWORD=test_password_here
EMAIL_USE_SSL=True

CELERY_BROKER_URL=redis://redis_host:6379/0
CELERY_RESULT_BACKEND=redis://redis_host:6379/1

REDIS_CHANNELS_URL=redis://redis_host:6379/2

REDIS_CELERY_ONCE_URL=redis://redis_host:6379/3

REDIS_CACHE_URL=redis://redis_host:6379/3

SOCIAL_AUTH_GITHUB_ID=test-github-client-id
SOCIAL_AUTH_GITHUB_SECRET=test-github-client-secret

SOCIAL_AUTH_GOOGLE_ID=test-google-client-id
SOCIAL_AUTH_GOOGLE_SECRET=test-google-client-secret

SOCIAL_AUTH_YANDEX_ID=test-yandex-client-id
SOCIAL_AUTH_YANDEX_SECRET=test-yandex-client-secret

SOCIAL_AUTH_VK_ID=test-vk-client-id
SOCIAL_AUTH_VK_SECRET=test-vk-client-secret
