DJANGO_SECRET_KEY=test-key-not-secret-test-key-not-secret

DEBUG=False

# Имя образа приложения без тега
STUDYOVERFLOW_IMAGE=studyoverflow-backend
# Имена остальных кастомных образов без тегов
LOKI_IMAGE=studyoverflow-loki
PROMTAIL_IMAGE=studyoverflow-promtail
NGINX_IMAGE=studyoverflow-nginx

# Тег пользовательских образов для CD (проверка prod-сборки): используется в
# docker-compose.yml / .prod.yml / .cd.yml, собираются в cd-checks.yml.
IMAGE_TAG=prod
# Тег образа приложения для CI: используется только в docker-compose.test.yml, собирается в ci.yml.
# Указывается два параметра, поскольку .env.test используется и для CI проверок, и для CD проверок.
IMAGE_TAG_CI=dev

SITE_DOMAIN=localhost

# nginx для e2e тестов через playwright, отдельный docker-compose, где контейнер с
# playwright подключается к существующей docker сети.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,nginx

# Настройки тестовой БД
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db
# При тестировании через docker-compose.test.yml (например в CI/CD) или через docker-compose.prod.yml (в CI/CD)
# переопределяются переменные POSTGRES_HOST и POSTGRES_PORT, используя docker контейнер с postgresql:
#     environment:
#       POSTGRES_HOST: "postgres"
#       POSTGRES_PORT: "5432"
#
# Имя сервиса PostgreSQL в сети Docker Compose, куда нужно обращаться Django приложению
POSTGRES_HOST=localhost
# Порт PostgreSQL, куда нужно обращаться Django приложению
POSTGRES_PORT=5432

FLOWER_BASIC_AUTH=admin:admin

# Указанные ниже сервисы для тестов не нужны, параметры задаются для корректного запуска приложения
# для тестирования.
AWS_ACCESS_KEY_ID=test-access-key-here
AWS_SECRET_ACCESS_KEY=test-secret-key-here
AWS_STORAGE_BUCKET_NAME=test-example-bucket

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=test_email@example.ru
EMAIL_HOST_PASSWORD=test_password_here
EMAIL_USE_SSL=True

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

REDIS_CHANNELS_URL=redis://redis:6379/2
REDIS_CELERY_ONCE_URL=redis://redis:6379/3
REDIS_CACHE_URL=redis://redis:6379/3

SOCIAL_AUTH_GITHUB_ID=test-github-client-id
SOCIAL_AUTH_GITHUB_SECRET=test-github-client-secret

SOCIAL_AUTH_GOOGLE_ID=test-google-client-id
SOCIAL_AUTH_GOOGLE_SECRET=test-google-client-secret

SOCIAL_AUTH_YANDEX_ID=test-yandex-client-id
SOCIAL_AUTH_YANDEX_SECRET=test-yandex-client-secret

SOCIAL_AUTH_VK_ID=test-vk-client-id
SOCIAL_AUTH_VK_SECRET=test-vk-client-secret
